generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

plugin openapi {
  provider = "@zenstackhq/openapi"
  flavor = "rpc"
  output = "doc/openapi.json"
  omitInputDetails = true
}

plugin hooks {
  provider = "@zenstackhq/tanstack-query"
  target = "react"
  version = "v5"
  output = "../ai-pos-app/src/_/hook"
  portable = true
}

enum OrderStatus {
  OPEN
  HELD
  PAID
  CANCELLED
  VOIDED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  PICKUP
}

enum PrintStatus {
  NOT_PRINTED
  PRINTING
  PRINTED
  FAILED
}

enum PaymentMethod {
  CASH
  CARD
  MANUAL
}

enum RefundStatus {
  COMPLETED
}

enum OrderAuditAction {
  CANCELLED
  VOIDED
  REFUNDED
  HELD
  RESUMED
  TABLE_OPENED
  TABLE_TRANSFERRED
  TABLE_MERGED
  BILL_SPLIT
  TABLE_CLEARED
}

enum BusinessDayStatus {
  OPEN
  CLOSED
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  OPENING
  SALE
  REFUND
  CASH_IN
  CASH_OUT
  ADJUSTMENT
}

enum CashMovementReferenceType {
  ORDER_PAYMENT
  REFUND
  MANUAL
}

enum KitchenStationStatus {
  ACTIVE
  INACTIVE
}

enum KitchenTicketStatus {
  NEW
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PrinterType {
  RECEIPT
  KITCHEN
  MULTI_PURPOSE
}

enum PrinterConnectionType {
  LAN
  USB
}

enum PrinterStatus {
  ACTIVE
  INACTIVE
}

enum PrinterRouteType {
  STORE_DEFAULT
  KITCHEN_STATION
}

enum PrintDocumentType {
  CUSTOMER_RECEIPT
  KITCHEN_TICKET
  REFUND_RECEIPT
  SHIFT_SUMMARY
  TEST_PAGE
}

enum PrintJobReferenceType {
  ORDER
  KITCHEN_TICKET
  REFUND
  SHIFT
  TEST
}

enum PrintJobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum PrintJobReason {
  AUTO
  MANUAL
  MANUAL_REPRINT
  TEST
}

enum AiDraftStatus {
  DRAFT
  CONFIRMED
  DISCARDED
}

enum StoreRole {
  OWNER
  MANAGER
  CASHIER
  STAFF
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
  ARCHIVED
}

enum CampaignType {
  ORDER_DISCOUNT
  THRESHOLD_DISCOUNT
  ITEM_DISCOUNT
  PROMO_CODE
  BUY_X_GET_Y
}

enum PromotionStackingPolicy {
  BEST_ONLY
  STACKABLE
  EXCLUSIVE
}

enum CatalogStatus {
  ACTIVE
  INACTIVE
}

enum ProductAvailabilityStatus {
  AVAILABLE
  SOLD_OUT
}

enum ModifierOptionStatus {
  ACTIVE
  INACTIVE
  SOLD_OUT
}

enum DiningTableStatus {
  AVAILABLE
  OCCUPIED
  DIRTY
  RESERVED
  INACTIVE
}

enum AiConversationStatus {
  ACTIVE
  ARCHIVED
}

enum AiMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum AiExecutionStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  FALLBACK
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum LoyaltyPointLedgerType {
  EARN
  ADJUST
  VOID
  REFUND_ADJUST
}

model Store {
  id        String     @id @default(cuid())
  name      String
  code      String?    @unique
  timezone  String     @default("Asia/Shanghai")
  currency  String     @default("USD")
  active    Boolean    @default(true)
  users     StoreUser[]
  categories Category[]
  diningAreas DiningArea[]
  diningTables DiningTable[]
  products  Product[]
  orders    Order[]
  refunds   Refund[]
  auditLogs OrderAuditLog[]
  shifts    Shift[]
  businessDays BusinessDay[]
  cashMovements CashMovement[]
  kitchenStations KitchenStation[]
  kitchenTickets KitchenTicket[]
  kitchenTicketItems KitchenTicketItem[]
  printers Printer[]
  printerRoutes PrinterRoute[]
  printJobs PrintJob[]
  aiDrafts  AiDraft[]
  campaigns Campaign[]
  aiConversations AiConversation[]
  aiMessages AiMessage[]
  aiExecutions AiExecution[]
  customers Customer[]
  loyaltyPointLedgers LoyaltyPointLedger[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@allow("all", true)
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String?
  passwordHash String
  active       Boolean     @default(true)
  stores       StoreUser[]
  operatedRefunds Refund[] @relation("RefundOperator")
  approvedRefunds Refund[] @relation("RefundApprover")
  operatedOrderAuditLogs OrderAuditLog[] @relation("OrderAuditOperator")
  approvedOrderAuditLogs OrderAuditLog[] @relation("OrderAuditApprover")
  shifts Shift[] @relation("ShiftStaff")
  openedShifts Shift[] @relation("ShiftOpenedBy")
  closedShifts Shift[] @relation("ShiftClosedBy")
  openedBusinessDays BusinessDay[] @relation("BusinessDayOpenedBy")
  closedBusinessDays BusinessDay[] @relation("BusinessDayClosedBy")
  cashMovements CashMovement[] @relation("CashMovementCreatedBy")
  createdKitchenTickets KitchenTicket[] @relation("KitchenTicketCreatedBy")
  requestedPrintJobs PrintJob[] @relation("PrintJobRequestedBy")
  createdLoyaltyPointLedgers LoyaltyPointLedger[] @relation("LoyaltyPointLedgerCreatedBy")
  aiConversations AiConversation[]
  aiMessages AiMessage[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@allow("all", true)
}

model StoreUser {
  id        String    @id @default(cuid())
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id])
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  role      StoreRole
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([storeId, userId])
  @@allow("all", true)
}

model Category {
  id        String        @id @default(cuid())
  storeId   String
  store     Store         @relation(fields: [storeId], references: [id])
  name      String
  status    CatalogStatus @default(ACTIVE)
  sortOrder Int           @default(0)
  defaultKitchenStationId String?
  defaultKitchenStation KitchenStation? @relation("CategoryDefaultKitchenStation", fields: [defaultKitchenStationId], references: [id])
  products  Product[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([storeId, name])
  @@index([storeId])
  @@index([defaultKitchenStationId])
  @@allow("all", true)
}

model DiningArea {
  id        String        @id @default(cuid())
  storeId   String
  store     Store         @relation(fields: [storeId], references: [id])
  name      String
  sortOrder Int           @default(0)
  status    CatalogStatus @default(ACTIVE)
  tables    DiningTable[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([storeId, name])
  @@index([storeId])
  @@allow("all", true)
}

model DiningTable {
  id             String            @id @default(cuid())
  storeId        String
  store          Store             @relation(fields: [storeId], references: [id])
  areaId         String
  area           DiningArea        @relation(fields: [areaId], references: [id])
  name           String
  seats          Int               @default(2)
  status         DiningTableStatus @default(AVAILABLE)
  sortOrder      Int               @default(0)
  currentOrderId String?           @unique
  currentOrder   Order?            @relation("CurrentTableOrder", fields: [currentOrderId], references: [id])
  orders         Order[]           @relation("OrderDiningTable")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([storeId, name])
  @@index([storeId, status])
  @@index([areaId])
  @@allow("all", true)
}

model Product {
  id             String                 @id @default(cuid())
  storeId        String?
  store          Store?                 @relation(fields: [storeId], references: [id])
  name           String
  description    String?                @db.Text
  categoryId     String?
  categoryRef    Category?              @relation(fields: [categoryId], references: [id])
  category       String?
  price          Decimal                @db.Decimal(10, 2)
  currency       String                 @default("USD")
  isActive       Boolean                @default(true)
  availabilityStatus ProductAvailabilityStatus @default(AVAILABLE)
  kitchenStationId String?
  kitchenStation KitchenStation? @relation("ProductKitchenStation", fields: [kitchenStationId], references: [id])
  modifierGroups ProductModifierGroup[]
  orderItems     OrderItem[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([storeId])
  @@index([categoryId])
  @@index([kitchenStationId])
  @@allow("all", true)
}

model ProductModifierGroup {
  id           String                  @id @default(cuid())
  productId    String
  product      Product                 @relation(fields: [productId], references: [id])
  name         String
  required     Boolean                 @default(false)
  multiSelect  Boolean                 @default(false)
  minSelect    Int                     @default(0)
  maxSelect    Int                     @default(1)
  status       CatalogStatus           @default(ACTIVE)
  displayOrder Int                     @default(0)
  options      ProductModifierOption[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@allow("all", true)
  @@index([productId])
}

model ProductModifierOption {
  id           String               @id @default(cuid())
  groupId      String
  group        ProductModifierGroup @relation(fields: [groupId], references: [id])
  name         String
  priceDelta   Decimal              @default(0) @db.Decimal(10, 2)
  status       ModifierOptionStatus @default(ACTIVE)
  displayOrder Int                  @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@allow("all", true)
  @@index([groupId])
}

model Order {
  id              String         @id @default(cuid())
  storeId         String?
  store           Store?         @relation(fields: [storeId], references: [id])
  orderNumber     String         @unique
  pickupNumber    String?
  orderType       OrderType     @default(TAKEAWAY)
  tableId         String?
  table           DiningTable?   @relation("OrderDiningTable", fields: [tableId], references: [id])
  currentForTable DiningTable?   @relation("CurrentTableOrder")
  customerId      String?
  customer        Customer?      @relation(fields: [customerId], references: [id])
  customerPhoneSnapshot String?
  customerNameSnapshot  String?
  loyaltyPointsEarned Int        @default(0)
  loyaltyPointsBalanceAfter Int?
  guestCount      Int?
  status          OrderStatus    @default(OPEN)
  printStatus     PrintStatus    @default(NOT_PRINTED)
  paymentMethod   PaymentMethod?
  currency        String         @default("USD")
  subtotal        Decimal        @db.Decimal(10, 2)
  adjustment      Decimal        @default(0) @db.Decimal(10, 2)
  promotionDiscountAmount Decimal @default(0) @db.Decimal(10, 2)
  manualDiscountAmount Decimal    @default(0) @db.Decimal(10, 2)
  totalDiscountAmount Decimal     @default(0) @db.Decimal(10, 2)
  appliedPromotions Json?
  adjustmentType  String?
  adjustmentValue Decimal?       @db.Decimal(10, 2)
  discountReason  String?        @db.Text
  taxRate         Decimal        @default(0) @db.Decimal(7, 4)
  tax             Decimal        @default(0) @db.Decimal(10, 2)
  serviceChargeRate Decimal      @default(0) @db.Decimal(7, 4)
  serviceCharge   Decimal        @default(0) @db.Decimal(10, 2)
  tip             Decimal        @default(0) @db.Decimal(10, 2)
  total           Decimal        @db.Decimal(10, 2)
  cashReceived    Decimal?       @db.Decimal(10, 2)
  changeDue       Decimal?       @db.Decimal(10, 2)
  paidAt          DateTime?
  printedAt       DateTime?
  heldAt          DateTime?
  resumedAt       DateTime?
  openedAt        DateTime?
  closedAt        DateTime?
  items           OrderItem[]
  payments        OrderPayment[]
  refunds         Refund[]
  auditLogs       OrderAuditLog[]
  kitchenTickets  KitchenTicket[]
  loyaltyPointLedgers LoyaltyPointLedger[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([storeId])
  @@index([tableId])
  @@index([customerId])
  @@index([storeId, paidAt])
  @@index([storeId, status, paidAt])
  @@allow("all", true)
}

model Customer {
  id              String         @id @default(cuid())
  storeId         String
  store           Store          @relation(fields: [storeId], references: [id])
  phone           String
  normalizedPhone String
  name            String?
  note            String?        @db.Text
  tags            Json?
  status          CustomerStatus @default(ACTIVE)
  firstOrderAt    DateTime?
  lastOrderAt     DateTime?
  orderCount      Int            @default(0)
  totalSpend      Decimal        @default(0) @db.Decimal(10, 2)
  pointsBalance   Int            @default(0)
  orders          Order[]
  pointLedgers    LoyaltyPointLedger[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([storeId, normalizedPhone])
  @@index([storeId, status])
  @@index([storeId, lastOrderAt])
  @@allow("all", true)
}

model LoyaltyPointLedger {
  id              String                 @id @default(cuid())
  storeId         String
  store           Store                  @relation(fields: [storeId], references: [id])
  customerId      String
  customer        Customer               @relation(fields: [customerId], references: [id])
  orderId         String?
  order           Order?                 @relation(fields: [orderId], references: [id])
  type            LoyaltyPointLedgerType
  points          Int
  balanceAfter    Int
  reason          String                 @db.Text
  createdByUserId String?
  createdBy       User?                  @relation("LoyaltyPointLedgerCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime               @default(now())

  @@index([storeId])
  @@index([customerId])
  @@index([orderId])
  @@index([storeId, createdAt])
  @@allow("all", true)
}

model BusinessDay {
  id             String            @id @default(cuid())
  storeId        String
  store          Store             @relation(fields: [storeId], references: [id])
  businessDate   DateTime
  status         BusinessDayStatus @default(OPEN)
  openedAt       DateTime          @default(now())
  closedAt       DateTime?
  openedByUserId String?
  openedBy       User?             @relation("BusinessDayOpenedBy", fields: [openedByUserId], references: [id])
  closedByUserId String?
  closedBy       User?             @relation("BusinessDayClosedBy", fields: [closedByUserId], references: [id])
  orderCount     Int               @default(0)
  grossSales     Decimal           @default(0) @db.Decimal(10, 2)
  refundTotal    Decimal           @default(0) @db.Decimal(10, 2)
  netSales       Decimal           @default(0) @db.Decimal(10, 2)
  notes          String?           @db.Text
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([storeId, status])
  @@index([storeId, businessDate])
  @@allow("all", true)
}

model OrderPayment {
  id             String        @id @default(cuid())
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id])
  method         PaymentMethod
  amount         Decimal       @db.Decimal(10, 2)
  amountReceived Decimal?      @db.Decimal(10, 2)
  changeDue      Decimal?      @db.Decimal(10, 2)
  createdAt      DateTime      @default(now())

  @@index([orderId, method])
  @@allow("all", true)
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  productNameSnapshot String?
  productCategorySnapshot String?
  quantity  Int
  unitPrice Decimal  @db.Decimal(10, 2)
  lineTotal Decimal  @db.Decimal(10, 2)
  modifiers Json?
  refundItems RefundItem[]
  kitchenTicketItems KitchenTicketItem[]
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
  @@allow("all", true)
}

model Refund {
  id             String        @id @default(cuid())
  storeId        String
  store          Store         @relation(fields: [storeId], references: [id])
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id])
  refundNumber   String        @unique
  idempotencyKey String
  status         RefundStatus  @default(COMPLETED)
  method         PaymentMethod
  amount         Decimal       @db.Decimal(10, 2)
  reason         String        @db.Text
  operatorId     String?
  operator       User?         @relation("RefundOperator", fields: [operatorId], references: [id])
  approvedById   String?
  approvedBy     User?         @relation("RefundApprover", fields: [approvedById], references: [id])
  items          RefundItem[]
  createdAt      DateTime      @default(now())

  @@unique([storeId, idempotencyKey])
  @@index([storeId])
  @@index([storeId, createdAt])
  @@index([orderId])
  @@allow("all", true)
}

model RefundItem {
  id          String    @id @default(cuid())
  refundId    String
  refund      Refund    @relation(fields: [refundId], references: [id])
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  quantity    Int
  amount      Decimal   @db.Decimal(10, 2)
  createdAt   DateTime  @default(now())

  @@index([refundId])
  @@index([orderItemId])
  @@allow("all", true)
}

model OrderAuditLog {
  id           String           @id @default(cuid())
  storeId      String
  store        Store            @relation(fields: [storeId], references: [id])
  orderId      String
  order        Order            @relation(fields: [orderId], references: [id])
  action       OrderAuditAction
  fromStatus   OrderStatus?
  toStatus     OrderStatus?
  amount       Decimal?         @db.Decimal(10, 2)
  reason       String           @db.Text
  operatorId   String?
  operator     User?            @relation("OrderAuditOperator", fields: [operatorId], references: [id])
  approvedById String?
  approvedBy   User?            @relation("OrderAuditApprover", fields: [approvedById], references: [id])
  createdAt    DateTime         @default(now())

  @@index([storeId])
  @@index([orderId])
  @@allow("all", true)
}

model Shift {
  id             String         @id @default(cuid())
  storeId        String
  store          Store          @relation(fields: [storeId], references: [id])
  userId         String
  user           User           @relation("ShiftStaff", fields: [userId], references: [id])
  status         ShiftStatus    @default(OPEN)
  openedAt       DateTime       @default(now())
  closedAt       DateTime?
  openingCash    Decimal        @default(0) @db.Decimal(10, 2)
  expectedCash   Decimal        @default(0) @db.Decimal(10, 2)
  actualCash     Decimal?       @db.Decimal(10, 2)
  variance       Decimal?       @db.Decimal(10, 2)
  openedByUserId String?
  openedBy       User?          @relation("ShiftOpenedBy", fields: [openedByUserId], references: [id])
  closedByUserId String?
  closedBy       User?          @relation("ShiftClosedBy", fields: [closedByUserId], references: [id])
  notes          String?        @db.Text
  movements      CashMovement[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([storeId])
  @@index([storeId, openedAt])
  @@index([storeId, userId, status])
  @@allow("all", true)
}

model CashMovement {
  id              String                    @id @default(cuid())
  storeId         String
  store           Store                     @relation(fields: [storeId], references: [id])
  shiftId         String
  shift           Shift                     @relation(fields: [shiftId], references: [id])
  type            CashMovementType
  amount          Decimal                   @db.Decimal(10, 2)
  reason          String                    @db.Text
  referenceType   CashMovementReferenceType @default(MANUAL)
  referenceId     String?
  createdByUserId String?
  createdBy       User?                     @relation("CashMovementCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime                  @default(now())

  @@unique([storeId, type, referenceType, referenceId])
  @@index([storeId])
  @@index([shiftId])
  @@allow("all", true)
}

model KitchenStation {
  id        String               @id @default(cuid())
  storeId   String
  store     Store                @relation(fields: [storeId], references: [id])
  name      String
  code      String
  status    KitchenStationStatus @default(ACTIVE)
  sortOrder Int                  @default(0)
  isDefault Boolean              @default(false)
  products  Product[]            @relation("ProductKitchenStation")
  categories Category[]          @relation("CategoryDefaultKitchenStation")
  tickets   KitchenTicket[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([storeId, code])
  @@index([storeId])
  @@allow("all", true)
}

model KitchenTicket {
  id              String              @id @default(cuid())
  storeId         String
  store           Store               @relation(fields: [storeId], references: [id])
  orderId         String
  order           Order               @relation(fields: [orderId], references: [id])
  stationId       String
  station         KitchenStation      @relation(fields: [stationId], references: [id])
  ticketNumber    String              @unique
  status          KitchenTicketStatus @default(NEW)
  startedAt       DateTime?
  readyAt         DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?             @db.Text
  createdByUserId String?
  createdBy       User?               @relation("KitchenTicketCreatedBy", fields: [createdByUserId], references: [id])
  items           KitchenTicketItem[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([storeId, orderId, stationId])
  @@index([storeId])
  @@index([storeId, createdAt])
  @@index([orderId])
  @@index([stationId])
  @@allow("all", true)
}

model KitchenTicketItem {
  id                  String              @id @default(cuid())
  storeId             String
  store               Store               @relation(fields: [storeId], references: [id])
  ticketId            String
  ticket              KitchenTicket       @relation(fields: [ticketId], references: [id])
  orderItemId         String
  orderItem           OrderItem           @relation(fields: [orderItemId], references: [id])
  productId           String
  productNameSnapshot String
  quantity            Int
  modifiers           Json?
  notes               String?             @db.Text
  status              KitchenTicketStatus @default(NEW)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([storeId])
  @@index([ticketId])
  @@index([orderItemId])
  @@allow("all", true)
}

model Printer {
  id              String                @id @default(cuid())
  storeId         String
  store           Store                 @relation(fields: [storeId], references: [id])
  name            String
  code            String
  type            PrinterType
  connectionType  PrinterConnectionType
  status          PrinterStatus         @default(ACTIVE)
  host            String?
  port            Int?
  usbVendorId     String?
  usbProductId    String?
  paperWidth      Int                   @default(80)
  autoCut         Boolean               @default(true)
  cashDrawerPulse Boolean               @default(false)
  routes          PrinterRoute[]
  printJobs       PrintJob[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([storeId, code])
  @@index([storeId])
  @@allow("all", true)
}

model PrinterRoute {
  id           String           @id @default(cuid())
  storeId      String
  store        Store            @relation(fields: [storeId], references: [id])
  printerId    String
  printer      Printer          @relation(fields: [printerId], references: [id])
  routeType    PrinterRouteType
  targetId     String?
  documentType PrintDocumentType
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([storeId, routeType, targetId, documentType])
  @@index([storeId])
  @@index([printerId])
  @@allow("all", true)
}

model PrintJob {
  id                String                 @id @default(cuid())
  storeId           String
  store             Store                  @relation(fields: [storeId], references: [id])
  printerId         String?
  printer           Printer?               @relation(fields: [printerId], references: [id])
  documentType      PrintDocumentType
  referenceType     PrintJobReferenceType
  referenceId       String
  status            PrintJobStatus         @default(PENDING)
  reason            PrintJobReason         @default(MANUAL)
  payload           Json
  renderedText      String?                @db.Text
  byteLength        Int?
  retryCount        Int                    @default(0)
  maxRetries        Int                    @default(3)
  lastError         String?                @db.Text
  autoPrintKey      String?
  sourceJobId       String?
  sourceJob         PrintJob?              @relation("PrintJobReprints", fields: [sourceJobId], references: [id])
  reprints          PrintJob[]             @relation("PrintJobReprints")
  requestedByUserId String?
  requestedBy       User?                  @relation("PrintJobRequestedBy", fields: [requestedByUserId], references: [id])
  claimedByDeviceId String?
  startedAt         DateTime?
  completedAt       DateTime?
  nextRetryAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([storeId, documentType, referenceType, referenceId, autoPrintKey])
  @@index([storeId])
  @@index([printerId])
  @@index([status])
  @@index([referenceType, referenceId])
  @@allow("all", true)
}

model AiDraft {
  id             String        @id @default(cuid())
  storeId        String?
  store          Store?        @relation(fields: [storeId], references: [id])
  prompt         String        @db.Text
  structuredJson Json
  status         AiDraftStatus @default(DRAFT)
  confirmedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([storeId])
  @@allow("all", true)
}

model Campaign {
  id             String         @id @default(cuid())
  storeId        String
  store          Store          @relation(fields: [storeId], references: [id])
  name           String
  goal           String?
  status         CampaignStatus @default(DRAFT)
  type           CampaignType   @default(ORDER_DISCOUNT)
  stackingPolicy PromotionStackingPolicy @default(BEST_ONLY)
  discountType   String?
  discountValue  Float?
  thresholdAmount Decimal?      @db.Decimal(10, 2)
  promoCode      String?
  productId      String?
  categoryName   String?
  startsAt       DateTime?
  endsAt         DateTime?
  priority       Int            @default(0)
  usageLimit     Int?
  usageCount     Int            @default(0)
  discountTotal  Decimal        @default(0) @db.Decimal(10, 2)
  timeWindow     String?
  bannerCopy     String?
  staffMessage   String?
  structuredJson Json?
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([storeId])
  @@index([storeId, status])
  @@index([storeId, promoCode])
  @@allow("all", true)
}

model AiConversation {
  id            String               @id @default(cuid())
  storeId       String
  store         Store                @relation(fields: [storeId], references: [id])
  userId        String
  user          User                 @relation(fields: [userId], references: [id])
  title         String
  status        AiConversationStatus @default(ACTIVE)
  lastMessageAt DateTime?
  messages      AiMessage[]
  executions    AiExecution[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([storeId])
  @@index([userId])
  @@index([storeId, userId, lastMessageAt])
  @@allow("all", true)
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id])
  storeId        String
  store          Store          @relation(fields: [storeId], references: [id])
  userId         String?
  user           User?          @relation(fields: [userId], references: [id])
  role           AiMessageRole
  content        String         @db.Text
  structuredData Json?
  periodContext  Json?
  executions     AiExecution[]
  createdAt      DateTime       @default(now())

  @@index([conversationId])
  @@index([storeId])
  @@index([userId])
  @@allow("all", true)
}

model AiExecution {
  id               String            @id @default(cuid())
  storeId          String
  store            Store             @relation(fields: [storeId], references: [id])
  conversationId   String
  conversation     AiConversation    @relation(fields: [conversationId], references: [id])
  messageId        String?
  message          AiMessage?        @relation(fields: [messageId], references: [id])
  provider         String
  model            String
  status           AiExecutionStatus @default(PENDING)
  contextType      String
  contextHash      String?
  inputTokenCount  Int?
  outputTokenCount Int?
  latencyMs        Int?
  errorCode        String?
  errorMessage     String?           @db.Text
  startedAt        DateTime          @default(now())
  completedAt      DateTime?
  createdAt        DateTime          @default(now())

  @@index([storeId])
  @@index([conversationId])
  @@index([messageId])
  @@index([status])
  @@allow("all", true)
}
