{
  "name": "ai-pos-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit",
    "zen": "zenstack generate && prisma db push",
    "zen:generate": "zenstack generate",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:push": "prisma db push --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.20",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.20",
    "@nestjs/platform-express": "^11.1.20",
    "@nestjs/swagger": "^11.2.3",
    "@prisma/client": "6.5.0",
    "@zenstackhq/runtime": "2.22.1",
    "@zenstackhq/server": "2.22.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "nestjs-cls": "^6.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.20",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@zenstackhq/openapi": "2.22.1",
    "@zenstackhq/tanstack-query": "2.22.1",
    "prisma": "6.5.0",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "zenstack": "2.22.1"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
