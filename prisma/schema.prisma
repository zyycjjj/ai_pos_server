datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum OrderStatus {
  OPEN
  PAID
  CANCELLED
  VOIDED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PrintStatus {
  NOT_PRINTED
  PRINTING
  PRINTED
  FAILED
}

enum PaymentMethod {
  CASH
  CARD
  MANUAL
}

enum RefundStatus {
  COMPLETED
}

enum OrderAuditAction {
  CANCELLED
  VOIDED
  REFUNDED
}

enum AiDraftStatus {
  DRAFT
  CONFIRMED
  DISCARDED
}

enum StoreRole {
  OWNER
  MANAGER
  CASHIER
  STAFF
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

enum CatalogStatus {
  ACTIVE
  INACTIVE
}

enum ProductAvailabilityStatus {
  AVAILABLE
  SOLD_OUT
}

enum ModifierOptionStatus {
  ACTIVE
  INACTIVE
  SOLD_OUT
}

model Store {
  id         String          @id() @default(cuid())
  name       String
  code       String?         @unique()
  timezone   String          @default("Asia/Shanghai")
  currency   String          @default("USD")
  active     Boolean         @default(true)
  users      StoreUser[]
  categories Category[]
  products   Product[]
  orders     Order[]
  refunds    Refund[]
  auditLogs  OrderAuditLog[]
  aiDrafts   AiDraft[]
  campaigns  Campaign[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt()
}

model User {
  id                     String          @id() @default(cuid())
  email                  String          @unique()
  name                   String?
  passwordHash           String
  active                 Boolean         @default(true)
  stores                 StoreUser[]
  operatedRefunds        Refund[]        @relation("RefundOperator")
  approvedRefunds        Refund[]        @relation("RefundApprover")
  operatedOrderAuditLogs OrderAuditLog[] @relation("OrderAuditOperator")
  approvedOrderAuditLogs OrderAuditLog[] @relation("OrderAuditApprover")
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt()
}

model StoreUser {
  id        String    @id() @default(cuid())
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id])
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  role      StoreRole
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt()

  @@unique([storeId, userId])
}

model Category {
  id        String        @id() @default(cuid())
  storeId   String
  store     Store         @relation(fields: [storeId], references: [id])
  name      String
  status    CatalogStatus @default(ACTIVE)
  sortOrder Int           @default(0)
  products  Product[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt()

  @@unique([storeId, name])
  @@index([storeId])
}

model Product {
  id                 String                    @id() @default(cuid())
  storeId            String?
  store              Store?                    @relation(fields: [storeId], references: [id])
  name               String
  description        String?                   @db.Text()
  categoryId         String?
  categoryRef        Category?                 @relation(fields: [categoryId], references: [id])
  category           String?
  price              Decimal                   @db.Decimal(10, 2)
  currency           String                    @default("USD")
  isActive           Boolean                   @default(true)
  availabilityStatus ProductAvailabilityStatus @default(AVAILABLE)
  modifierGroups     ProductModifierGroup[]
  orderItems         OrderItem[]
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt()

  @@index([storeId])
  @@index([categoryId])
}

model ProductModifierGroup {
  id           String                  @id() @default(cuid())
  productId    String
  product      Product                 @relation(fields: [productId], references: [id])
  name         String
  required     Boolean                 @default(false)
  multiSelect  Boolean                 @default(false)
  minSelect    Int                     @default(0)
  maxSelect    Int                     @default(1)
  status       CatalogStatus           @default(ACTIVE)
  displayOrder Int                     @default(0)
  options      ProductModifierOption[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt()
}

model ProductModifierOption {
  id           String               @id() @default(cuid())
  groupId      String
  group        ProductModifierGroup @relation(fields: [groupId], references: [id])
  name         String
  priceDelta   Decimal              @default(0) @db.Decimal(10, 2)
  status       ModifierOptionStatus @default(ACTIVE)
  displayOrder Int                  @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt()
}

model Order {
  id              String          @id() @default(cuid())
  storeId         String?
  store           Store?          @relation(fields: [storeId], references: [id])
  orderNumber     String          @unique()
  pickupNumber    String?
  status          OrderStatus     @default(OPEN)
  printStatus     PrintStatus     @default(NOT_PRINTED)
  paymentMethod   PaymentMethod?
  currency        String          @default("USD")
  subtotal        Decimal         @db.Decimal(10, 2)
  adjustment      Decimal         @default(0) @db.Decimal(10, 2)
  adjustmentType  String?
  adjustmentValue Decimal?        @db.Decimal(10, 2)
  tax             Decimal         @default(0) @db.Decimal(10, 2)
  tip             Decimal         @default(0) @db.Decimal(10, 2)
  total           Decimal         @db.Decimal(10, 2)
  cashReceived    Decimal?        @db.Decimal(10, 2)
  changeDue       Decimal?        @db.Decimal(10, 2)
  paidAt          DateTime?
  printedAt       DateTime?
  items           OrderItem[]
  payments        OrderPayment[]
  refunds         Refund[]
  auditLogs       OrderAuditLog[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt()

  @@index([storeId])
}

model OrderPayment {
  id             String        @id() @default(cuid())
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id])
  method         PaymentMethod
  amount         Decimal       @db.Decimal(10, 2)
  amountReceived Decimal?      @db.Decimal(10, 2)
  changeDue      Decimal?      @db.Decimal(10, 2)
  createdAt      DateTime      @default(now())
}

model OrderItem {
  id                      String       @id() @default(cuid())
  orderId                 String
  order                   Order        @relation(fields: [orderId], references: [id])
  productId               String
  product                 Product      @relation(fields: [productId], references: [id])
  productNameSnapshot     String?
  productCategorySnapshot String?
  quantity                Int
  unitPrice               Decimal      @db.Decimal(10, 2)
  lineTotal               Decimal      @db.Decimal(10, 2)
  modifiers               Json?
  refundItems             RefundItem[]
  createdAt               DateTime     @default(now())
}

model Refund {
  id             String        @id() @default(cuid())
  storeId        String
  store          Store         @relation(fields: [storeId], references: [id])
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id])
  refundNumber   String        @unique()
  idempotencyKey String
  status         RefundStatus  @default(COMPLETED)
  method         PaymentMethod
  amount         Decimal       @db.Decimal(10, 2)
  reason         String        @db.Text()
  operatorId     String?
  operator       User?         @relation("RefundOperator", fields: [operatorId], references: [id])
  approvedById   String?
  approvedBy     User?         @relation("RefundApprover", fields: [approvedById], references: [id])
  items          RefundItem[]
  createdAt      DateTime      @default(now())

  @@unique([storeId, idempotencyKey])
  @@index([storeId])
  @@index([orderId])
}

model RefundItem {
  id          String    @id() @default(cuid())
  refundId    String
  refund      Refund    @relation(fields: [refundId], references: [id])
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  quantity    Int
  amount      Decimal   @db.Decimal(10, 2)
  createdAt   DateTime  @default(now())

  @@index([refundId])
  @@index([orderItemId])
}

model OrderAuditLog {
  id           String           @id() @default(cuid())
  storeId      String
  store        Store            @relation(fields: [storeId], references: [id])
  orderId      String
  order        Order            @relation(fields: [orderId], references: [id])
  action       OrderAuditAction
  fromStatus   OrderStatus?
  toStatus     OrderStatus?
  amount       Decimal?         @db.Decimal(10, 2)
  reason       String           @db.Text()
  operatorId   String?
  operator     User?            @relation("OrderAuditOperator", fields: [operatorId], references: [id])
  approvedById String?
  approvedBy   User?            @relation("OrderAuditApprover", fields: [approvedById], references: [id])
  createdAt    DateTime         @default(now())

  @@index([storeId])
  @@index([orderId])
}

model AiDraft {
  id             String        @id() @default(cuid())
  storeId        String?
  store          Store?        @relation(fields: [storeId], references: [id])
  prompt         String        @db.Text()
  structuredJson Json
  status         AiDraftStatus @default(DRAFT)
  confirmedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt()

  @@index([storeId])
}

model Campaign {
  id             String         @id() @default(cuid())
  storeId        String
  store          Store          @relation(fields: [storeId], references: [id])
  name           String
  goal           String?
  status         CampaignStatus @default(DRAFT)
  discountType   String?
  discountValue  Float?
  timeWindow     String?
  bannerCopy     String?
  staffMessage   String?
  structuredJson Json?
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt()

  @@index([storeId])
}
